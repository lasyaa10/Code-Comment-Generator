{
  "name": "code-comment-generator",
  "displayName": "CodeCommentGenerator",
  "description": "AI-powered inline & above-line code comments using Gemini (free)",
  "publisher": "Hanish",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarshaJyos/ccg.git"
  },
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages",
    "Productivity"
  ],
  "icon": "images/icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeCommentGenerator.generateComments",
        "title": "Generate AI Comments"
      },
      {
        "command": "codeCommentGenerator.setApiKey",
        "title": "Set Gemini API Key"
      }
    ],
    "configuration": {
      "title": "Code Comment Generator",
      "properties": {
        "codeCommentGenerator.commentMode": {
          "type": "string",
          "enum": [
            "inline",
            "above"
          ],
          "default": "inline",
          "description": "inline = end of line, above = line above"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-comment-container",
          "title": "AI Comment Generator",
          "icon": "images/comment-icon.svg"
          
        }
      ]
    },
    "views": {
      "code-comment-container": [
        {
          "id": "code-comment-welcome",
          "name": "Welcome",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.7.7"
  }
}
